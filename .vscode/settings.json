{
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/storage": true,
    "**/.next": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/storage": true,
    "**/.next": true
  },
  "files.watcherExclude": {
